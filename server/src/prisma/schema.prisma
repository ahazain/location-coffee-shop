// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


/*
|--------------------------------------------------------------------------
| 1. USER / ADMIN
|--------------------------------------------------------------------------
*/

model User {
  id_user    Int      @id @default(autoincrement())
  nama       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(100)
  password   String   @db.Text
  role       String   @default("admin") @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

/*
|--------------------------------------------------------------------------
| 2. GRID ANALISIS
|--------------------------------------------------------------------------
| Grid menjadi unit tampilan hasil akhir.
| Geometry disarankan EPSG:32749 karena raster penelitian memakai UTM Zone 49S.
| Jika frontend butuh GeoJSON 4326, lakukan ST_Transform(geom, 4326) di API.
|--------------------------------------------------------------------------
*/

model Grid {
  id_grid   Int      @id @default(autoincrement())
  kode_grid String   @unique @db.VarChar(50)

  kecamatan String?  @db.VarChar(100)
  kelurahan String?  @db.VarChar(100)
  luas_grid Decimal? @db.Decimal(15, 6)

  geom Unsupported("geometry(Polygon,32749)")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  hasil_wlc HasilWlc[]

  @@map("grid")
}

/*
|--------------------------------------------------------------------------
| 3. KRITERIA DAN INDIKATOR
|--------------------------------------------------------------------------
*/

model Kriteria {
  id_kriteria   Int      @id @default(autoincrement())
  kode_kriteria String?  @unique @db.VarChar(50)
  nama_kriteria String   @db.VarChar(100)
  deskripsi     String?  @db.Text
  urutan        Int?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  indikator Indikator[]

  bobot_kriteria BobotKriteria?

  ahp_kriteria_1 AhpKriteriaMatrix[] @relation("AhpKriteria1")
  ahp_kriteria_2 AhpKriteriaMatrix[] @relation("AhpKriteria2")

  ahp_indikator_matrix AhpIndikatorMatrix[]
  ahp_konsistensi      AhpKonsistensi[]

  @@map("kriteria")
}

model Indikator {
  id_indikator    Int      @id @default(autoincrement())
  id_kriteria     Int
  kode_indikator  String?  @unique @db.VarChar(50)
  nama_indikator  String   @db.VarChar(150)
  satuan          String?  @db.VarChar(50)

  // Contoh: benefit, cost, competition, constraint
  jenis_indikator String?  @db.VarChar(50)

  // Menjelaskan hasil preprocessing QGIS
  tipe_nilai        String? @db.VarChar(50) // kepadatan, jarak, intensitas, mask
  sumber_data       String? @db.Text
  metode_pengolahan String? @db.Text

  deskripsi  String?  @db.Text
  urutan     Int?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  kriteria Kriteria @relation(fields: [id_kriteria], references: [id_kriteria], onDelete: Cascade)

  aturan_fuzzy    AturanFuzzy?
  bobot_indikator BobotIndikator?
  raster_layers   RasterLayer[]

  ahp_indikator_1 AhpIndikatorMatrix[] @relation("AhpIndikator1")
  ahp_indikator_2 AhpIndikatorMatrix[] @relation("AhpIndikator2")

  simulasi_bobot_indikator SimulasiBobotIndikator[]

  @@index([id_kriteria])
  @@map("indikator")
}

/*
|--------------------------------------------------------------------------
| 4. RASTER LAYER / GEOTIFF
|--------------------------------------------------------------------------
| Semua GeoTIFF raw, fuzzy, mask, dan final_score dicatat di tabel ini.
| File tetap disimpan di storage, database hanya menyimpan metadata.
|--------------------------------------------------------------------------
*/

model RasterLayer {
  id_raster_layer Int  @id @default(autoincrement())

  // Untuk raw dan fuzzy indikator, id_indikator terisi.
  // Untuk final_score, id_indikator boleh null.
  id_indikator    Int?

  // Untuk raster hasil WLC, bisa dikaitkan ke proses analisis.
  id_analysis_run Int?

  // raw, fuzzy, mask, final_score
  tipe_raster String @db.VarChar(30)

  file_path         String
  original_filename String?

  crs          String? @db.VarChar(50)
  resolution_x Float?
  resolution_y Float?
  width        Int?
  height       Int?
  band_count   Int?
  extent       Json?

  min_value           Float?
  max_value           Float?
  mean_value          Float?
  std_value           Float?
  nodata_value        Float?
  jumlah_pixel        Int?
  jumlah_pixel_valid  Int?
  jumlah_pixel_nodata Int?

  versi     Int     @default(1)
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  indikator    Indikator?   @relation(fields: [id_indikator], references: [id_indikator], onDelete: SetNull)
  analysis_run AnalysisRun? @relation(fields: [id_analysis_run], references: [id_analysis_run], onDelete: SetNull)

  @@unique([id_indikator, tipe_raster, versi])
  @@index([id_indikator])
  @@index([id_analysis_run])
  @@index([tipe_raster])
  @@index([is_active])
  @@map("raster_layers")
}

/*
|--------------------------------------------------------------------------
| 5. ATURAN FUZZY
|--------------------------------------------------------------------------
*/

model AturanFuzzy {
  id_aturan    Int @id @default(autoincrement())
  id_indikator Int @unique

  // linear_increasing, linear_decreasing, fuzzy_near
  fungsi_fuzzy String @db.VarChar(50)

  // increasing, decreasing, near
  arah String @db.VarChar(20)

  // Untuk linear increasing / decreasing
  nilai_min Decimal? @db.Decimal(18, 6)
  nilai_max Decimal? @db.Decimal(18, 6)

  // Untuk fuzzy near
  midpoint Decimal? @db.Decimal(18, 6)
  spread   Decimal? @db.Decimal(18, 6)

  // Cadangan jika nanti memakai triangular/trapezoid
  nilai_a Decimal? @db.Decimal(18, 6)
  nilai_b Decimal? @db.Decimal(18, 6)
  nilai_c Decimal? @db.Decimal(18, 6)
  nilai_d Decimal? @db.Decimal(18, 6)

  keterangan String? @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  indikator Indikator @relation(fields: [id_indikator], references: [id_indikator], onDelete: Cascade)

  @@map("aturan_fuzzy")
}

/*
|--------------------------------------------------------------------------
| 6. AHP KRITERIA
|--------------------------------------------------------------------------
*/

model AhpKriteriaMatrix {
  id_matrix          Int      @id @default(autoincrement())
  id_kriteria_1      Int
  id_kriteria_2      Int
  nilai_perbandingan Decimal  @db.Decimal(18, 6)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  kriteria_1 Kriteria @relation("AhpKriteria1", fields: [id_kriteria_1], references: [id_kriteria], onDelete: Cascade)
  kriteria_2 Kriteria @relation("AhpKriteria2", fields: [id_kriteria_2], references: [id_kriteria], onDelete: Cascade)

  @@unique([id_kriteria_1, id_kriteria_2])
  @@index([id_kriteria_2])
  @@map("ahp_kriteria_matrix")
}

model BobotKriteria {
  id_bobot_kriteria Int      @id @default(autoincrement())
  id_kriteria       Int      @unique
  bobot_kriteria    Decimal  @db.Decimal(10, 6)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  kriteria Kriteria @relation(fields: [id_kriteria], references: [id_kriteria], onDelete: Cascade)

  @@map("bobot_kriteria")
}

/*
|--------------------------------------------------------------------------
| 7. AHP INDIKATOR
|--------------------------------------------------------------------------
*/

model AhpIndikatorMatrix {
  id_matrix          Int      @id @default(autoincrement())
  id_kriteria        Int
  id_indikator_1     Int
  id_indikator_2     Int
  nilai_perbandingan Decimal  @db.Decimal(18, 6)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  kriteria    Kriteria  @relation(fields: [id_kriteria], references: [id_kriteria], onDelete: Cascade)
  indikator_1 Indikator @relation("AhpIndikator1", fields: [id_indikator_1], references: [id_indikator], onDelete: Cascade)
  indikator_2 Indikator @relation("AhpIndikator2", fields: [id_indikator_2], references: [id_indikator], onDelete: Cascade)

  @@unique([id_kriteria, id_indikator_1, id_indikator_2])
  @@index([id_indikator_1])
  @@index([id_indikator_2])
  @@map("ahp_indikator_matrix")
}

model BobotIndikator {
  id_bobot_indikator Int      @id @default(autoincrement())
  id_indikator       Int      @unique

  // Bobot lokal dalam kriteria
  bobot_lokal Decimal @db.Decimal(10, 6)

  // Bobot akhir = bobot kriteria × bobot lokal indikator
  bobot_akhir Decimal @db.Decimal(10, 6)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  indikator Indikator @relation(fields: [id_indikator], references: [id_indikator], onDelete: Cascade)

  @@map("bobot_indikator")
}

/*
|--------------------------------------------------------------------------
| 8. KONSISTENSI AHP
|--------------------------------------------------------------------------
*/

model AhpKonsistensi {
  id_konsistensi     Int      @id @default(autoincrement())
  tipe               String   @db.VarChar(30) // kriteria / indikator
  id_kriteria        Int?
  lambda_max         Decimal? @db.Decimal(18, 6)
  consistency_index  Decimal? @db.Decimal(18, 6)
  consistency_ratio  Decimal? @db.Decimal(18, 6)
  status_konsistensi String?  @db.VarChar(30)
  tanggal_hitung     DateTime @default(now())

  kriteria Kriteria? @relation(fields: [id_kriteria], references: [id_kriteria], onDelete: SetNull)

  @@index([id_kriteria])
  @@map("ahp_konsistensi")
}

/*
|--------------------------------------------------------------------------
| 9. ANALYSIS RUN / RIWAYAT PERHITUNGAN WLC
|--------------------------------------------------------------------------
| Dipakai untuk menyimpan versi hasil WLC.
| Jika ada update GeoTIFF, sistem membuat analysis run baru.
|--------------------------------------------------------------------------
*/

model AnalysisRun {
  id_analysis_run Int @id @default(autoincrement())

  // default, simulasi
  tipe_run String @default("default") @db.VarChar(30)

  id_simulasi Int?

  nama_run   String? @db.VarChar(150)
  status     String  @default("success") @db.VarChar(30)
  keterangan String? @db.Text

  versi     Int     @default(1)
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  simulasi      Simulasi?      @relation(fields: [id_simulasi], references: [id_simulasi], onDelete: SetNull)
  hasil_wlc     HasilWlc[]
  raster_layers RasterLayer[]

  @@index([id_simulasi])
  @@index([tipe_run])
  @@index([is_active])
  @@map("analysis_run")
}

/*
|--------------------------------------------------------------------------
| 10. HASIL WLC PER GRID
|--------------------------------------------------------------------------
| GeoTIFF final_score tetap disimpan di RasterLayer.
| Tabel ini dipakai untuk popup WebGIS, kategori, ranking, dan pencarian.
|--------------------------------------------------------------------------
*/

model HasilWlc {
  id_hasil        Int @id @default(autoincrement())
  id_analysis_run Int
  id_grid         Int

  skor_wlc         Decimal @db.Decimal(10, 6)
  kelas_kesesuaian String  @db.VarChar(50)
  ranking          Int?

  tanggal_hitung DateTime @default(now())

  analysis_run AnalysisRun @relation(fields: [id_analysis_run], references: [id_analysis_run], onDelete: Cascade)
  grid         Grid        @relation(fields: [id_grid], references: [id_grid], onDelete: Cascade)

  @@unique([id_analysis_run, id_grid])
  @@index([id_grid])
  @@index([skor_wlc])
  @@map("hasil_wlc")
}

/*
|--------------------------------------------------------------------------
| 11. SIMULASI BOBOT
|--------------------------------------------------------------------------
| Bagian ini boleh dihapus jika aplikasi kamu tidak punya fitur simulasi bobot.
|--------------------------------------------------------------------------
*/

model Simulasi {
  id_simulasi   Int      @id @default(autoincrement())
  nama_simulasi String?  @db.VarChar(100)
  deskripsi     String?  @db.Text
  created_at    DateTime @default(now())

  simulasi_bobot_indikator SimulasiBobotIndikator[]
  analysis_runs            AnalysisRun[]

  @@map("simulasi")
}

model SimulasiBobotIndikator {
  id_simulasi_bobot Int     @id @default(autoincrement())
  id_simulasi       Int
  id_indikator      Int
  bobot_simulasi    Decimal @db.Decimal(10, 6)

  simulasi  Simulasi  @relation(fields: [id_simulasi], references: [id_simulasi], onDelete: Cascade)
  indikator Indikator @relation(fields: [id_indikator], references: [id_indikator], onDelete: Cascade)

  @@unique([id_simulasi, id_indikator])
  @@index([id_indikator])
  @@map("simulasi_bobot_indikator")
}