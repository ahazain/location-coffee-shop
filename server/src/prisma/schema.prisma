// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


/*
|--------------------------------------------------------------------------
| 1. USER / ADMIN
|--------------------------------------------------------------------------
*/

model User {
  id_user    Int      @id @default(autoincrement())
  nama       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(100)
  password   String   @db.Text
  role       String   @default("admin") @db.VarChar(20)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("users")
}

/*
|--------------------------------------------------------------------------
| 2. GRID ANALISIS
|--------------------------------------------------------------------------
| Grid menjadi unit tampilan hasil akhir.
| Geometry disarankan EPSG:32749 karena raster penelitian memakai UTM Zone 49S.
| Jika frontend butuh GeoJSON 4326, lakukan ST_Transform(geom, 4326) di API.
| Catatan: luas_grid TIDAK disimpan di DB, hitung langsung via ST_Area(geom)
| agar tidak ada risiko data tidak sinkron dengan geometry.
|--------------------------------------------------------------------------
*/

model Grid {
  id_grid   Int     @id @default(autoincrement())
  kode_grid String  @unique @db.VarChar(50)

  kecamatan String? @db.VarChar(100)
  kelurahan String? @db.VarChar(100)

  geom Unsupported("geometry(Polygon,32749)")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  hasil_wlc HasilWlc[]

  @@map("grid")
}

/*
|--------------------------------------------------------------------------
| 3. KRITERIA DAN INDIKATOR
|--------------------------------------------------------------------------
*/

model Kriteria {
  id_kriteria   Int      @id @default(autoincrement())
  nama_kriteria String   @db.VarChar(100)
  deskripsi     String?  @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  indikator Indikator[]

  bobot_kriteria BobotKriteria[]

  ahp_kriteria_1 AhpKriteriaMatrix[] @relation("AhpKriteria1")
  ahp_kriteria_2 AhpKriteriaMatrix[] @relation("AhpKriteria2")

  ahp_indikator_matrix AhpIndikatorMatrix[]
  ahp_konsistensi      AhpKonsistensi[]

  @@map("kriteria")
}

model Indikator {
  id_indikator   Int      @id @default(autoincrement())
  id_kriteria    Int
  nama_indikator String   @db.VarChar(150)
  satuan         String?  @db.VarChar(50)

  // Menjelaskan bentuk nilai raster: kepadatan, jarak, intensitas, mask
  tipe_nilai String? @db.VarChar(50)

  deskripsi  String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  kriteria Kriteria @relation(fields: [id_kriteria], references: [id_kriteria], onDelete: Cascade)

  aturan_fuzzy    AturanFuzzy?
  bobot_indikator BobotIndikator[]
  raster_layers   RasterLayer[]

  ahp_indikator_1 AhpIndikatorMatrix[] @relation("AhpIndikator1")
  ahp_indikator_2 AhpIndikatorMatrix[] @relation("AhpIndikator2")

  @@index([id_kriteria])
  @@map("indikator")
}

/*
|--------------------------------------------------------------------------
| 4. RASTER LAYER / GEOTIFF
|--------------------------------------------------------------------------
| Semua GeoTIFF raw, fuzzy, mask, dan final_score dicatat di tabel ini.
| File tetap disimpan di storage, database hanya menyimpan metadata penting.
|
| Tidak ada kolom "versi" / "is_active": update = hapus record lama (dan
| file fisiknya), lalu insert record baru. Constraint unique memastikan
| hanya ada 1 raster aktif per indikator + tipe_raster.
|
| Metadata teknis (resolution, width, height, band_count, extent, std_value,
| jumlah_pixel*) TIDAK disimpan di DB -- baca langsung dari file GeoTIFF
| via GDAL/rasterio saat dibutuhkan.
|--------------------------------------------------------------------------
*/

model RasterLayer {
  id_raster_layer Int @id @default(autoincrement())

  // Untuk raw dan fuzzy indikator, id_indikator terisi.
  // Untuk final_score, id_indikator boleh null.
  id_indikator Int?

  // Untuk raster hasil WLC, dikaitkan ke proses analisis (selalu yang terbaru).
  id_analysis_run Int?

  // raw, fuzzy, mask, final_score
  tipe_raster String @db.VarChar(30)

  file_path String

  crs          String? @db.VarChar(50)
  min_value    Float?
  max_value    Float?
  mean_value   Float?
  nodata_value Float?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  indikator    Indikator?   @relation(fields: [id_indikator], references: [id_indikator], onDelete: SetNull)
  analysis_run AnalysisRun? @relation(fields: [id_analysis_run], references: [id_analysis_run], onDelete: SetNull)

  @@unique([id_indikator, tipe_raster])
  @@index([id_indikator])
  @@index([id_analysis_run])
  @@index([tipe_raster])
  @@map("raster_layers")
}

/*
|--------------------------------------------------------------------------
| 5. ATURAN FUZZY
|--------------------------------------------------------------------------
| Field triangular/trapezoid (nilai_a/b/c/d) dihapus karena belum dipakai
| (YAGNI) -- tambahkan lagi via migration kalau nanti benar-benar dibutuhkan.
|--------------------------------------------------------------------------
*/

model AturanFuzzy {
  id_aturan    Int @id @default(autoincrement())
  id_indikator Int @unique

  // linear_increasing, linear_decreasing, fuzzy_near
  fungsi_fuzzy String @db.VarChar(50)

  // increasing, decreasing, near
  arah String @db.VarChar(20)

  // Untuk linear increasing / decreasing
  nilai_min Decimal? @db.Decimal(18, 6)
  nilai_max Decimal? @db.Decimal(18, 6)

  // Untuk fuzzy near
  midpoint Decimal? @db.Decimal(18, 6)
  spread   Decimal? @db.Decimal(18, 6)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  indikator Indikator @relation(fields: [id_indikator], references: [id_indikator], onDelete: Cascade)

  @@map("aturan_fuzzy")
}

model Pakar {
  id_pakar   Int     @id @default(autoincrement())
  nama_pakar String  @db.VarChar(100)
  institusi  String? @db.VarChar(100)
  jabatan    String? @db.VarChar(100)
  is_active  Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  ahp_kriteria_matrix  AhpKriteriaMatrix[]
  ahp_indikator_matrix AhpIndikatorMatrix[]
  ahp_konsistensi      AhpKonsistensi[]
  bobot_kriteria       BobotKriteria[]
  bobot_indikator      BobotIndikator[]

  @@map("pakar")
}

/*
|--------------------------------------------------------------------------
| 6. AHP KRITERIA
|--------------------------------------------------------------------------
*/

model AhpKriteriaMatrix {
  id_matrix          Int      @id @default(autoincrement())
  id_pakar           Int
  id_kriteria_1      Int
  id_kriteria_2      Int
  nilai_perbandingan Decimal  @db.Decimal(18, 6)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  pakar      Pakar    @relation(fields: [id_pakar], references: [id_pakar], onDelete: Cascade)
  kriteria_1 Kriteria @relation("AhpKriteria1", fields: [id_kriteria_1], references: [id_kriteria], onDelete: Cascade)
  kriteria_2 Kriteria @relation("AhpKriteria2", fields: [id_kriteria_2], references: [id_kriteria], onDelete: Cascade)

  @@unique([id_pakar, id_kriteria_1, id_kriteria_2])
  @@index([id_kriteria_2])
  @@index([id_pakar])
  @@map("ahp_kriteria_matrix")
}

model BobotKriteria {
  id_bobot_kriteria Int      @id @default(autoincrement())
  id_pakar          Int?
  id_kriteria       Int
  bobot_kriteria    Decimal  @db.Decimal(10, 6)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  pakar    Pakar?   @relation(fields: [id_pakar], references: [id_pakar], onDelete: Cascade)
  kriteria Kriteria @relation(fields: [id_kriteria], references: [id_kriteria], onDelete: Cascade)

  @@unique([id_pakar, id_kriteria])
  @@index([id_kriteria])
  @@index([id_pakar])
  @@map("bobot_kriteria")
}

/*
|--------------------------------------------------------------------------
| 7. AHP INDIKATOR
|--------------------------------------------------------------------------
*/

model AhpIndikatorMatrix {
  id_matrix          Int      @id @default(autoincrement())
  id_pakar           Int
  id_kriteria        Int
  id_indikator_1     Int
  id_indikator_2     Int
  nilai_perbandingan Decimal  @db.Decimal(18, 6)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  pakar       Pakar     @relation(fields: [id_pakar], references: [id_pakar], onDelete: Cascade)
  kriteria    Kriteria  @relation(fields: [id_kriteria], references: [id_kriteria], onDelete: Cascade)
  indikator_1 Indikator @relation("AhpIndikator1", fields: [id_indikator_1], references: [id_indikator], onDelete: Cascade)
  indikator_2 Indikator @relation("AhpIndikator2", fields: [id_indikator_2], references: [id_indikator], onDelete: Cascade)

  @@unique([id_pakar, id_kriteria, id_indikator_1, id_indikator_2])
  @@index([id_indikator_1])
  @@index([id_indikator_2])
  @@index([id_pakar])
  @@map("ahp_indikator_matrix")
}

model BobotIndikator {
  id_bobot_indikator Int      @id @default(autoincrement())
  id_pakar           Int?
  id_indikator       Int

  // Bobot lokal dalam kriteria
  bobot_lokal Decimal @db.Decimal(10, 6)

  // Bobot akhir = bobot kriteria x bobot lokal indikator
  bobot_akhir Decimal @db.Decimal(10, 6)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pakar     Pakar?    @relation(fields: [id_pakar], references: [id_pakar], onDelete: Cascade)
  indikator Indikator @relation(fields: [id_indikator], references: [id_indikator], onDelete: Cascade)

  @@unique([id_pakar, id_indikator])
  @@index([id_indikator])
  @@index([id_pakar])
  @@map("bobot_indikator")
}

/*
|--------------------------------------------------------------------------
| 8. KONSISTENSI AHP
|--------------------------------------------------------------------------
*/

model AhpKonsistensi {
  id_konsistensi     Int      @id @default(autoincrement())
  id_pakar           Int?
  tipe               String   @db.VarChar(30) // kriteria / indikator
  id_kriteria        Int?
  lambda_max         Decimal? @db.Decimal(18, 6)
  consistency_index  Decimal? @db.Decimal(18, 6)
  consistency_ratio  Decimal? @db.Decimal(18, 6)
  status_konsistensi String?  @db.VarChar(30)
  tanggal_hitung     DateTime @default(now())

  pakar    Pakar?    @relation(fields: [id_pakar], references: [id_pakar], onDelete: Cascade)
  kriteria Kriteria? @relation(fields: [id_kriteria], references: [id_kriteria], onDelete: SetNull)

  @@index([id_kriteria])
  @@index([id_pakar])
  @@map("ahp_konsistensi")
}

/*
|--------------------------------------------------------------------------
| 9. ANALYSIS RUN / PROSES PERHITUNGAN WLC (SELALU YANG TERBARU)
|--------------------------------------------------------------------------
| Tidak ada riwayat run. Setiap kali ada perubahan (bobot AHP baru, raster
| diupdate, dll), sistem menghitung ulang WLC dari awal:
|   1. Hapus AnalysisRun lama -> cascade hapus HasilWlc lama,
|      RasterLayer final_score terkait jadi id_analysis_run = NULL.
|   2. Insert AnalysisRun baru.
|   3. Insert ulang HasilWlc untuk AnalysisRun baru.
|   4. Update RasterLayer final_score -> arahkan ke AnalysisRun baru.
| Hasilnya di DB selalu hanya ada 1 AnalysisRun yang merepresentasikan
| kondisi final/resmi saat ini -- bukan riwayat.
|
| Simulasi bobot oleh GUEST tidak masuk ke sini sama sekali -- itu murni
| di sisi client (localStorage per device), backend hanya menyediakan
| endpoint stateless untuk hitung ulang WLC on-the-fly tanpa menulis ke DB.
|--------------------------------------------------------------------------
*/

model AnalysisRun {
  id_analysis_run Int     @id @default(autoincrement())
  nama_run        String? @db.VarChar(150)
  status          String  @default("success") @db.VarChar(30)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  hasil_wlc     HasilWlc[]
  raster_layers RasterLayer[]

  @@map("analysis_run")
}

/*
|--------------------------------------------------------------------------
| 10. HASIL WLC PER GRID
|--------------------------------------------------------------------------
| GeoTIFF final_score tetap disimpan di RasterLayer.
| Tabel ini dipakai untuk popup WebGIS, kategori, ranking, dan pencarian.
| Selalu berisi hasil AnalysisRun yang paling terbaru saja.
|--------------------------------------------------------------------------
*/

model HasilWlc {
  id_hasil        Int @id @default(autoincrement())
  id_analysis_run Int
  id_grid         Int

  skor_wlc         Decimal @db.Decimal(10, 6)
  kelas_kesesuaian String  @db.VarChar(50)
  ranking          Int?
  nilai_indikator  Json?

  tanggal_hitung DateTime @default(now())

  analysis_run AnalysisRun @relation(fields: [id_analysis_run], references: [id_analysis_run], onDelete: Cascade)
  grid         Grid        @relation(fields: [id_grid], references: [id_grid], onDelete: Cascade)

  @@unique([id_analysis_run, id_grid])
  @@index([id_grid])
  @@index([skor_wlc])
  @@map("hasil_wlc")
}

/*
|--------------------------------------------------------------------------
| 11. EXISTING COFFEE SHOP
|--------------------------------------------------------------------------
| Berdiri sendiri, hanya untuk overlay lokasi kompetitor eksisting di peta.
|--------------------------------------------------------------------------
*/

model ExistingCoffeeShop {
  id_shop    Int      @id @default(autoincrement())
  nama       String?  @db.VarChar(150)
  latitude   Float
  longitude  Float
  geom       Unsupported("geometry(Point,32749)")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("existing_coffee_shop")
}